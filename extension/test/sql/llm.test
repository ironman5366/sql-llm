# name: test/sql/llm.test
# description: test llm catalog extension skeleton
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT quack('Sam');
----
Catalog Error: Scalar Function with name quack does not exist!

# Require statement will ensure this test is run with this extension loaded
require llm

statement ok
ATTACH '' AS llm (TYPE llm);

query I
SHOW TABLES FROM llm;
----

statement error
CREATE TABLE llm.whatever (id INTEGER, prompt VARCHAR);
----
LLM CREATE TABLE requires safetensors-backed catalog metadata

query I
SHOW TABLES FROM llm;
----

statement error
SELECT * FROM llm.whatever;
----
Table with name whatever does not exist

statement error
INSERT INTO llm.whatever VALUES (1, 'hello');
----
Table with name whatever does not exist

statement error
UPDATE llm.whatever SET prompt = 'world' WHERE id = 1;
----
Table with name whatever does not exist

statement error
DELETE FROM llm.whatever WHERE id = 1;
----
Table with name whatever does not exist

statement error
CREATE TABLE llm.created AS SELECT 1 AS id;
----
LLM CREATE TABLE AS requires safetensors-backed catalog metadata
